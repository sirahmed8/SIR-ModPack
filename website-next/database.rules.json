{
  "rules": {
    ".read": false,
    ".write": false,
    "releases": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "changelogs": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "broadcasts": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "analytics": {
      "downloads": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "downloads": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "presence": {
      ".read": true,
      "sessions": {
        "$sessionId": {
          ".read": true,
          ".write": "auth != null && auth.uid === $sessionId"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "launcherProfiles": {
          "$profileId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "launcherSyncCodes": {
          "$code": {
            ".read": "auth != null && auth.uid === $uid && data.child('ownerUid').val() === auth.uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('ownerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['ownerUid', 'expiresAt']) && newData.child('ownerUid').val() === auth.uid"
          }
        },
        "claimedAccounts": {
          "$accountId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "minecraft": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "microsoftAccount": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
