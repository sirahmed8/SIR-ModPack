rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      match /claimedAccounts/{accountId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /error_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.token.admin == true;
    }

    match /download_events/{eventId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    match /changelogs/{changelogId} {
      allow read: if true;
      allow write, create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write, create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /releases/{releaseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    
    match /leaderboard_records/{recordId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
